# EdgeVoice AI 서버 설정 — 설치 프로그램이 이 파일을 바탕으로 .env 를 만든다 (비밀 값은 무작위로 채운다).
# 손으로 만들 때: 이 파일을 .env 로 복사하고 change-me 를 모두 긴 무작위 문자열로 바꾼다.

# 받을 서비스 이미지 태그 (릴리스 태그, 예: v1.2.3). 설치 프로그램이 업데이트 때 올린다
EDGEVOICE_VERSION=latest
# EDGEVOICE_REGISTRY=ghcr.io/ghlee0786

# 비밀 값 — 공개 기본값을 쓰지 않는다
POSTGRES_PASSWORD=change-me
SEARXNG_SECRET=change-me
SESSION_SECRET=change-me

# HuggingFace 토큰 (선택 — 공개 모델은 없어도 받는다. 받기 속도 제한을 피하려면 넣는다)
HF_TOKEN=

# 모델 폴더 (기본: 이 폴더의 models)
# MODEL_CACHE_PATH=./models

# 모델 바꾸기 (기본값은 docker-compose.yml 에 있다)
# LLM_MODEL=RedHatAI/Qwen3.5-9B-quantized.w4a16
# LLM_GPU_UTIL=0.62
# STT_MODEL=large-v3-turbo
# TTS_ENGINE=melo

# 인터넷 검색 (기본 꺼짐) — searxng 는 'docker compose --profile search up -d'
# INTERNET_TOOLS_ENABLED=true
# SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://searxng:8080

# 브라우저·컴퓨터 조작 (소스 저장소의 scripts/start-browser-mcp.ps1 · start-desktop-mcp.ps1 을 이 PC 에서 띄운 뒤)
# MCP_CONFIG_PATH=/app/config/mcp/servers.json
